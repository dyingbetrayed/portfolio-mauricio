---
import Navbar from './Navbar.astro';
---

<section class="slide about-slide" id="about">
	<header class="about-header reveal" style="--reveal-delay: 60ms">
		<h1 class="name-title top-name-title">Mauricio Atencia</h1>
		<Navbar theme="dark" active="about" />
	</header>

	<div class="about-content-wrapper" data-v-scroll>
		<div class="about-center reveal" style="--reveal-delay: 160ms">
			<img src="/about/image.png" alt="Mauricio Atencia" class="about-image" />
		</div>

		<div class="about-footer-container reveal" style="--reveal-delay: 280ms">
			<div class="location-text">Medellín, Colombia</div>
			<hr class="about-divider" />
			<div class="about-footer-content">
				<div class="about-title">About</div>
				<div class="about-text">
					<p>
						Durante más de cuatro años he desarrollado identidades visuales, experiencias de marca y espacios comerciales donde la estrategia, el diseño y la ejecución, trabajan como un solo sistema. 
					</p>
					<p>
												Mi enfoque combina branding, retail y dirección de arte para crear marcas coherentes, memorables y listas para el mundo real. Todo esto a través de  diferentes empresas, agencias y la ficha studio, un proyecto personal que captura mi vision
					</p>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.about-slide {
		flex: 0 0 100vw;
		width: 100vw;
		height: 100vh;
		height: 100dvh;
		scroll-snap-align: start;
		position: relative;
		overflow: hidden;
		box-sizing: border-box;

		background-color: #eeedec;
		color: #000000;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}

	.about-header {
		position: relative;
		z-index: 2;
		flex: 0 0 auto;
		padding: var(--pad-header-y) var(--pad-header-x-r) 0.35rem var(--pad-header-x-l);
		display: flex;
		align-items: flex-start;
		width: 100%;
		box-sizing: border-box;
		justify-content: flex-end;
		background-color: #eeedec;
	}

	.top-name-title {
		position: absolute;
		left: var(--pad-header-x-l);
		top: var(--pad-header-y);
		z-index: 10;
		pointer-events: none;
	}

	.about-content-wrapper {
		display: flex;
		flex-direction: column;
		flex: 1;
		min-height: 0;
		padding: 0 var(--pad-section-x-r) var(--pad-section-b) var(--pad-section-x-l);
		box-sizing: border-box;
		width: 100%;
		overflow-x: hidden;
		overflow-y: auto;
		overscroll-behavior: contain;
		-webkit-overflow-scrolling: touch;
		touch-action: pan-y;
	}

	.about-center {
		flex: 1 1 auto;
		min-height: clamp(150px, 34vh, 320px);
		display: flex;
		justify-content: center;
		align-items: flex-end;
		padding: 0 0 clamp(0.5rem, 1.2vw, 1.5rem) 0;
	}

	.about-image {
		height: clamp(150px, 38vh, 620px);
		width: auto;
		max-width: 100%;
		object-fit: cover;
		display: block;
		--img-lift: clamp(0.75rem, 1.8vw, 2.25rem);
		transform: translateY(var(--img-lift));
		transition: transform var(--dur-slow) var(--ease-out);
	}

	.about-slide.is-active .about-image {
		--img-lift: clamp(0.35rem, 1vw, 1.25rem);
	}

	@media (max-height: 500px) {
		.about-center {
			flex: 0 0 auto;
			min-height: clamp(100px, 42vh, 180px);
		}

		.about-image {
			height: clamp(100px, 42vh, 180px);
			--img-lift: 0.5rem;
		}

		.name-title {
			font-size: clamp(1rem, 4.2vw, 1.7rem);
			-webkit-text-stroke: 1px #000000;
		}
	}

	@media (min-height: 501px) and (max-width: 1440px) {
		.about-image {
			height: clamp(150px, 34vh, 340px);
		}

		.about-center {
			min-height: clamp(150px, 34vh, 340px);
			padding-bottom: 0;
		}
	}

	.about-footer-container {
		display: flex;
		flex-direction: column;
		width: 100%;
		--footer-lift: clamp(0.2rem, 0.4vh, 0.4rem);
		transform: translateY(calc(-1 * var(--footer-lift)));
	}

	.location-text {
		font-family: var(--font-helvetica);
		font-weight: 300;
		font-size: clamp(0.75rem, 1.05vw, 1.6rem);
		text-align: right;
		margin-bottom: clamp(0.35rem, 0.6vw, 1rem);
		letter-spacing: 0.03em;
	}

	.about-divider {
		border: none;
		border-top: clamp(2px, 0.15vw, 4px) solid #000000;
		width: 100%;
		margin: 0 0 clamp(0.65rem, 1.1vw, 1.75rem) 0;
		transform: scaleX(0.92);
		transform-origin: left center;
		transition: transform var(--dur-med) var(--ease-out) 180ms;
	}

	.about-slide.is-active .about-divider {
		transform: scaleX(1);
	}

	.about-footer-content {
		display: flex;
		justify-content: flex-start;
		align-items: flex-start;
		gap: 0;
		flex-wrap: nowrap;
	}

	.about-title {
		font-family: var(--font-nav);
		font-weight: 600;
		font-size: clamp(0.95rem, 1.4vw, 2.15rem);
		flex: 0 0 auto;
		line-height: 1;
		padding-top: 0.15em;
		margin-right: clamp(0.5rem, 1.2vw, 1.5rem);
	}

	.name-title {
		font-family: var(--font-nav);
		font-weight: 600;
		font-size: clamp(1.4rem, 12vw, 5.75rem);
		margin: 0;
		color: #000000;
		line-height: 0.95;
		flex: 0 1 auto;
		min-width: 0;
		letter-spacing: -0.022em;
		/* Antes: max(1px, 0.07vw) — sin tope, se engrosaba de más
		   en pantallas 4K/ultrawide. Ahora topado con clamp(). */
		-webkit-text-stroke: clamp(1px, 0.07vw, 2px) #000000;
	}

	.about-text {
		font-family: var(--font-helvetica);
		font-weight: 300;
		font-size: clamp(0.7rem, 1.05vw, 1.55rem);
		line-height: 1.2;
		flex: 1 1 min(46rem, 38vw);
		width: min(46rem, 38vw);
		max-width: min(46rem, 44%);
		min-width: min(16rem, 100%);
		margin-left: var(--text-align-offset, auto);
		text-align: justify;
	}

	@media (max-width: 900px) {
		/* El encabezado reserva el alto del nombre para que la foto nunca
		   ascienda hasta alcanzarlo en pantallas tÃ¡ctiles. */
		.about-header {
			min-height: calc(var(--pad-header-y) + clamp(2.5rem, 10vw, 3.75rem));
		}

		.top-name-title {
			font-size: clamp(1.5rem, 10vw, 3.5rem);
		}

		@supports (height: 1dvh) {
			.top-name-title {
				font-size: clamp(1.5rem, min(10vw, 7dvh), 3.5rem);
			}
		}

		.about-footer-content {
			flex-direction: column;
			gap: 0.75rem;
		}

		.about-text {
			width: 100%;
			max-width: 100%;
			margin-left: 0;
			flex: 1 1 auto;
		}
	}

	.about-text p {
		margin: 0;
	}

	.about-text p + p {
		margin-top: 1em;
	}
</style>

<script>
function syncTextToImage() {
	const section = document.querySelector('.about-slide') as HTMLElement | null;
	if (!section) return;

	const img = section.querySelector('.about-image');
	const aboutLabel = section.querySelector('.about-footer-content .about-title') as HTMLElement | null;
	if (!img || !aboutLabel || window.innerWidth <= 900) {
		section.style.removeProperty('--text-align-offset');
		return;
	}

	const imgRect = img.getBoundingClientRect();
	const labelRect = aboutLabel.getBoundingClientRect();
	const labelMarginRight = parseFloat(getComputedStyle(aboutLabel).marginRight) || 0;
	const naturalTextStart = labelRect.right + labelMarginRight;
	const offset = imgRect.left - naturalTextStart;

	if (offset > 0) {
		section.style.setProperty('--text-align-offset', `${offset}px`);
	} else {
		section.style.setProperty('--text-align-offset', `clamp(1rem, 2vw, 2rem)`);
	}
}

	function syncTitleToNav() {
	const header = document.querySelector('.about-header') as HTMLElement | null;
	const title = document.querySelector('.top-name-title') as HTMLElement | null;
	const firstNavLink = document.querySelector('.about-header .navbar a') as HTMLElement | null;
	if (!header || !title || !firstNavLink) return;

		title.style.fontSize = '';
		if (window.matchMedia('(max-width: 900px)').matches) return;

	const titleRect = title.getBoundingClientRect();
	const navRect = firstNavLink.getBoundingClientRect();
	const minGap = 20;

	const overlap = (titleRect.right + minGap) - navRect.left;

	if (overlap > 0 && titleRect.width > 0) {
		const currentSize = parseFloat(getComputedStyle(title).fontSize);
		const availableWidth = Math.max(0, titleRect.width - overlap);
		const minSize = 14;
		const newSize = Math.max(minSize, currentSize * (availableWidth / titleRect.width));
		title.style.fontSize = `${newSize}px`;
	}
}

function scheduleSync() {
	requestAnimationFrame(() => {
		syncTextToImage();
		syncTitleToNav();
	});
}

scheduleSync();
window.addEventListener('resize', scheduleSync);
window.addEventListener('load', scheduleSync);

if (document.fonts?.ready) {
	document.fonts.ready.then(scheduleSync);
}

const headerEl = document.querySelector('.about-header');
if (headerEl && 'ResizeObserver' in window) {
	new ResizeObserver(scheduleSync).observe(headerEl);
}
</script>
