---
import QuoteSimilarButton from './QuoteSimilarButton.astro';
import type { Project } from '../data/projects';

export interface Props {
	project: Project;
	src: string;
	index: number;
	total: number;
}

const { project, src, index, total } = Astro.props;
const isLast = index >= total - 1;
const label = `${project.name} — imagen ${index + 1} de ${total}`;
---

<article
	class="project-image"
	data-project-image={project.slug}
	data-image-index={String(index)}
	hidden
>
	<header class="project-image__nav">
		<button type="button" class="project-image__back" data-nav-back aria-label="Volver">
			<span class="project-image__back-icon" aria-hidden="true">←</span>
			<span>Volver</span>
		</button>
	</header>

	<figure class="project-image__figure">
		<img class="project-image__img" src={src} alt={label} loading="lazy" decoding="async" />
	</figure>

	<div class="project-image__footer">
		<QuoteSimilarButton
			projectName={project.name}
			color={project.color}
			class="project-image__quote"
		/>

		{isLast ? (
			<button
				type="button"
				class="project-image__next"
				data-open-project-next={project.slug}
			>
				<span>Siguiente</span>
				<span class="project-image__next-icon" aria-hidden="true">→</span>
			</button>
		) : (
			<button
				type="button"
				class="project-image__next"
				data-open-project-image={project.slug}
				data-image-index={String(index + 1)}
			>
				<span>Siguiente</span>
				<span class="project-image__next-icon" aria-hidden="true">→</span>
			</button>
		)}
	</div>
</article>

<style>
	.project-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		background: #0a0a0a;
		box-sizing: border-box;
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}

	.project-image[hidden] {
		display: none;
	}

	.project-image__nav {
		position: absolute;
		top: 0;
		left: 0;
		z-index: 5;
		padding: 1.5rem 2rem;
		background: linear-gradient(to bottom, rgba(0, 0, 0, 0.45), transparent);
	}

	.project-image__back {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		border: none;
		background: transparent;
		padding: 0;
		cursor: pointer;
		font-family: var(--font-nav);
		font-weight: 600;
		font-size: clamp(1.05rem, 1.15vw, 1.7rem);
		letter-spacing: 0.03em;
		color: #ffffff;
		flex-shrink: 0;
		text-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
	}

	.project-image__back:hover {
		opacity: 0.7;
	}

	.project-image__back-icon {
		font-size: 1.1em;
		line-height: 1;
	}

	.project-image__figure {
		margin: 0;
		flex: 1;
		min-height: 0;
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #0a0a0a;
	}

	.project-image__img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.project-image__footer {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 5;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		padding: clamp(1rem, 2.5vh, 1.75rem) clamp(1.25rem, 3vw, 2.5rem);
		background: linear-gradient(to top, rgba(0, 0, 0, 0.4), transparent);
		pointer-events: none;
	}

	.project-image__footer > :global(*) {
		pointer-events: auto;
	}

	.project-image__next {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		border: none;
		background: transparent;
		color: #ffffff;
		cursor: pointer;
		font-family: var(--font-nav);
		font-weight: 600;
		font-size: clamp(0.95rem, 1.05vw, 1.45rem);
		letter-spacing: 0.03em;
		padding: 0;
		margin-left: auto;
		text-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
		transition: opacity 0.2s ease;
	}

	.project-image__next:hover {
		opacity: 0.7;
	}

	.project-image__next-icon {
		font-size: 1.1em;
		line-height: 1;
	}

	@media (max-width: 768px) {
		.project-image__nav {
			padding: 1.25rem 1.5rem;
		}

		.project-image__footer {
			padding: 1rem 1.25rem 1.25rem;
		}
	}
</style>
