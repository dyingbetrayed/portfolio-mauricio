---
import QuoteSimilarButton from './QuoteSimilarButton.astro';
import type { Project } from '../data/projects';

export interface Props {
	project: Project;
	src: string;
	index: number;
	total: number;
}

const { project, src, index, total } = Astro.props;
const isLast = index >= total - 1;
const label = `${project.name} — imagen ${index + 1} de ${total}`;
---

<article
	class="project-image"
	data-project-image={project.slug}
	data-image-index={String(index)}
	hidden
>
	<header class="project-image__nav">
		<button type="button" class="project-image__back" data-nav-back aria-label="Volver">
			<span class="project-image__back-icon" aria-hidden="true">←</span>
			<span>Volver</span>
		</button>
	</header>

	<figure class="project-image__figure">
		<img
			class="project-image__img"
			src={src}
			alt={label}
			loading="eager"
			decoding="async"
			fetchpriority="high"
		/>
	</figure>

	<div class="project-image__footer">
		<QuoteSimilarButton
			projectName={project.name}
			color={project.color}
			slug={project.slug}
			class="project-image__quote"
		/>
		<button
			type="button"
			class="project-image__scroll-hint"
			aria-label="Continuar a la siguiente imagen o proyecto"
			data-work-forward
			data-cursor-nav
		>
			<div class="project-image__scroll-hint-arrow" aria-hidden="true">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="M5 12h14M12 5l7 7-7 7"/>
				</svg>
			</div>
		</button>
	</div>
</article>

<style>
	.project-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		background: #0a0a0a;
		box-sizing: border-box;
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}

	.project-image[hidden] {
		display: none;
	}

	.project-image.is-entering-forward {
		animation: project-image-enter-forward var(--dur-panel, 0.9s) var(--ease-out, cubic-bezier(0.4, 0, 0.2, 1)) both;
	}

	.project-image.is-entering-backward {
		animation: project-image-enter-backward var(--dur-panel, 0.9s) var(--ease-out, cubic-bezier(0.4, 0, 0.2, 1)) both;
	}

	@keyframes project-image-enter-forward {
		from {
			transform: translate3d(3%, 0, 0);
			opacity: 0;
		}

		to {
			transform: translate3d(0, 0, 0);
			opacity: 1;
		}
	}

	@keyframes project-image-enter-backward {
		from {
			transform: translate3d(-3%, 0, 0);
			opacity: 0;
		}

		to {
			transform: translate3d(0, 0, 0);
			opacity: 1;
		}
	}

	.project-image__nav {
		display: none;
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		z-index: 5;
		padding: var(--pad-header-y) var(--pad-header-x-r) 0.35rem var(--pad-header-x-l);
		background: linear-gradient(to bottom, rgba(0, 0, 0, 0.45), transparent);
	}

	.project-image__back {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		border: none;
		background: transparent;
		padding: 0;
		cursor: pointer;
		font-family: var(--font-nav);
		font-weight: 600;
		font-size: var(--nav-size);
		letter-spacing: 0.03em;
		color: #ffffff;
		flex-shrink: 0;
		text-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
	}

	.project-image__back:hover {
		opacity: 0.7;
	}

	.project-image__back-icon {
		font-size: 1.1em;
		line-height: 1;
	}

	.project-image__figure {
		margin: 0;
		flex: 1;
		min-height: 0;
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #0a0a0a;
	}

	.project-image__img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: center;
	}

	.project-image__footer {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 5;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		padding: clamp(0.65rem, 2.5vh, 1.75rem) var(--pad-section-x-r)
			max(clamp(0.65rem, 2.5vh, 1.75rem), var(--sab)) var(--pad-section-x-l);
		background: linear-gradient(to top, rgba(0, 0, 0, 0.4), transparent);
		pointer-events: none;
	}

	.project-image__footer > :global(*) {
		pointer-events: auto;
	}

	.project-image__scroll-hint {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		color: #ffffff;
		padding: clamp(0.45rem, 1.2vh, 1rem) 14px clamp(0.45rem, 1.2vh, 1rem) 0;
		margin-right: -14px;
		border: none;
		background: transparent;
		cursor: pointer;
		overflow: visible;
		opacity: 0.7;
		transition: opacity var(--dur-med) var(--ease-out);
	}

	.project-image__scroll-hint:hover {
		opacity: 1;
	}

	.project-image__scroll-hint:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 0.35rem;
	}

	.project-image__scroll-hint-arrow {
		display: flex;
		align-items: center;
		justify-content: center;
		animation: project-image-hint-bounce-x 2s cubic-bezier(0.28, 0.84, 0.42, 1) infinite;
	}

	@keyframes project-image-hint-bounce-x {
		0%, 100% { transform: translateX(0); }
		50% { transform: translateX(8px); }
	}



	@media (prefers-reduced-motion: reduce) {
		.project-image.is-entering-forward,
		.project-image.is-entering-backward {
			animation: none;
		}
	}

	@media (max-width: 700px) {
		.project-image.is-entering-forward {
			animation-name: project-image-enter-up;
		}

		.project-image.is-entering-backward {
			animation-name: project-image-enter-down;
		}

		@keyframes project-image-enter-up {
			from {
				transform: translate3d(0, 3%, 0);
				opacity: 0;
			}

			to {
				transform: translate3d(0, 0, 0);
				opacity: 1;
			}
		}

		@keyframes project-image-enter-down {
			from {
				transform: translate3d(0, -3%, 0);
				opacity: 0;
			}

			to {
				transform: translate3d(0, 0, 0);
				opacity: 1;
			}
		}
	}
</style>
