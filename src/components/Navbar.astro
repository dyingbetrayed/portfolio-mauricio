---
import Logo from './Logo.astro';

export type NavSection = 'about' | 'work' | 'ikeneas' | 'contact';

interface Props {
	theme?: 'light' | 'dark';
	/** Sección a la que pertenece el slide que contiene este navbar */
	active?: NavSection;
	/** Mostrar logo a la izquierda sin alterar la posición de los nav items */
	showLogo?: boolean;
}

const { theme = 'light', active, showLogo = false } = Astro.props;

const links: { id: NavSection; label: string }[] = [
	{ id: 'about', label: 'About' },
	{ id: 'work', label: 'Work' },
	{ id: 'ikeneas', label: 'Ikeneas' },
	{ id: 'contact', label: 'Contact' },
];
---

<nav class={`navbar ${theme}${showLogo ? ' has-logo' : ''}`}>
	{showLogo && <Logo class="navbar-logo" />}
	<ul>
		{links.map((link) => (
			<li>
				<a href={`#${link.id}`} aria-current={active === link.id ? 'page' : undefined}>
					{link.label}
				</a>
			</li>
		))}
	</ul>
</nav>

<style>
	.navbar {
		display: flex;
		justify-content: flex-end;
		align-items: center;
		width: 100%;
		position: relative;
	}

	.navbar :global(.navbar-logo) {
		position: absolute;
		left: 0;
		top: 0;
		pointer-events: auto;
	}

	.navbar ul {
		display: flex;
		gap: calc(var(--nav-gap) * 1.4);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.navbar a {
		position: relative;
		display: inline-block;
		font-family: var(--font-nav);
		font-weight: 600;
		font-size: var(--nav-size);
		letter-spacing: 0.03em;
		text-transform: capitalize;
		transition: opacity var(--dur-fast) var(--ease-out), letter-spacing var(--dur-med) var(--ease-out);
	}

	.navbar a:hover {
		opacity: 0.75;
		letter-spacing: 0.05em;
	}

	/* Subrayado animado de la sección actual */
	.navbar a::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -0.35em;
		height: max(2px, 0.09em);
		background-color: currentColor;
		transform: scaleX(0);
		transform-origin: left center;
		transition: transform var(--dur-med) var(--ease-out);
	}

	.navbar a[aria-current='page']::after {
		transform: scaleX(1);
	}

	.light a {
		color: #ffffff;
	}

	.dark a {
		color: #000000;
	}
</style>