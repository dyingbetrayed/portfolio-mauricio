---
const toEmail = 'mauricioatenciam@gmail.com';
---

<div
	class="contact-drawer-backdrop"
	id="contact-drawer-backdrop"
	hidden
	data-contact-backdrop
	aria-hidden="true"
></div>

<div
	class="contact-drawer"
	id="contact-drawer"
	hidden
	aria-hidden="true"
	role="dialog"
	aria-modal="true"
	aria-labelledby="contact-drawer-title"
>
	<form class="contact-drawer__form" data-contact-form>
		<h2 id="contact-drawer-title" class="visually-hidden">Send email</h2>

		<div class="contact-drawer__body">
			<div class="contact-drawer__row">
				<span class="contact-drawer__label">To:</span>
				<span class="contact-drawer__value">{toEmail}</span>
			</div>

			<hr class="contact-drawer__rule" />

			<label class="contact-drawer__row contact-drawer__row--input">
				<span class="contact-drawer__label">From:</span>
				<input
					class="contact-drawer__input"
					type="email"
					name="from"
					placeholder="enter your email address"
					autocomplete="email"
					required
				/>
			</label>

			<hr class="contact-drawer__rule" />

			<label class="contact-drawer__message">
				<span class="contact-drawer__label">Message:</span>
				<textarea
					class="contact-drawer__textarea"
					name="message"
					rows="8"
					required
				></textarea>
			</label>
		</div>

		<div class="contact-drawer__actions">
			<button type="submit" class="contact-drawer__btn contact-drawer__btn--send">
				Send email
			</button>
			<button type="button" class="contact-drawer__btn contact-drawer__btn--cancel" data-contact-cancel>
				Cancel
			</button>
		</div>
	</form>
</div>

<style>
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.contact-drawer-backdrop {
		position: absolute;
		inset: 0;
		z-index: 39;
		background: transparent;
		border: none;
		padding: 0;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition: opacity 0.3s ease, visibility 0s linear 0.3s;
	}

	.contact-drawer-backdrop.is-open {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		transition-delay: 0s;
	}

	.contact-drawer-backdrop[hidden] {
		display: block;
	}

	.contact-drawer {
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		left: auto;
		z-index: 40;
		display: flex;
		flex-direction: column;
		width: min(100%, 26.5rem);
		background: #000000;
		color: #ffffff;
		box-sizing: border-box;
		transform: translateX(100%);
		transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), visibility 0s linear 0.4s;
		visibility: hidden;
		pointer-events: none;
	}

	.contact-drawer.is-open {
		transform: translateX(0);
		visibility: visible;
		pointer-events: auto;
		transition-delay: 0s;
	}

	.contact-drawer[hidden] {
		display: flex;
	}

	.contact-drawer__form {
		display: flex;
		flex-direction: column;
		flex: 1;
		min-height: 0;
		width: 100%;
		height: 100%;
	}

	.contact-drawer__body {
		flex: 1;
		min-height: 0;
		display: flex;
		flex-direction: column;
		padding: clamp(0.35rem, 0.8vh, 0.65rem) clamp(0.85rem, 1.5vw, 1.25rem) 0;
		overflow: auto;
	}

	.contact-drawer__row {
		display: flex;
		align-items: baseline;
		gap: 0.4em;
		padding: clamp(0.85rem, 1.6vh, 1.25rem) 0;
		font-family: var(--font-helvetica);
		font-weight: 300;
		font-size: clamp(1rem, 1.15vw, 1.35rem);
		letter-spacing: 0.02em;
	}

	.contact-drawer__row--input {
		cursor: text;
	}

	.contact-drawer__label {
		flex: 0 0 auto;
		color: #ffffff;
	}

	.contact-drawer__value {
		color: #ffffff;
	}

	.contact-drawer__input {
		flex: 1;
		min-width: 0;
		border: none;
		background: transparent;
		color: #ffffff;
		font: inherit;
		letter-spacing: inherit;
		padding: 0;
		outline: none;
	}

	.contact-drawer__input::placeholder {
		color: rgba(255, 255, 255, 0.55);
	}

	.contact-drawer__rule {
		border: none;
		border-top: 1px solid rgba(255, 255, 255, 0.35);
		margin: 0;
		width: 100%;
	}

	.contact-drawer__message {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: clamp(0.75rem, 1.5vh, 1.25rem);
		flex: 1;
		min-height: 0;
		padding: clamp(0.85rem, 1.6vh, 1.25rem) 0 clamp(1.5rem, 3vh, 2.5rem);
		font-family: var(--font-helvetica);
		font-weight: 300;
		font-size: clamp(1rem, 1.15vw, 1.35rem);
		letter-spacing: 0.02em;
		cursor: text;
	}

	.contact-drawer__textarea {
		flex: 1;
		min-height: 12rem;
		width: 100%;
		border: none;
		resize: none;
		background: transparent;
		color: #ffffff;
		font: inherit;
		letter-spacing: inherit;
		padding: 0;
		outline: none;
	}

	.contact-drawer__actions {
		display: flex;
		flex-shrink: 0;
		width: 100%;
	}

	.contact-drawer__btn {
		border: none;
		margin: 0;
		cursor: pointer;
		font-family: var(--font-nav);
		font-weight: 600;
		font-size: clamp(1rem, 1.2vw, 1.45rem);
		letter-spacing: 0.03em;
		color: #ffffff;
		padding: clamp(1.1rem, 2.4vh, 1.75rem) 1rem;
		text-align: left;
		transition: filter 0.2s ease, opacity 0.2s ease;
	}

	.contact-drawer__btn:hover {
		filter: brightness(1.08);
	}

	.contact-drawer__btn--send {
		flex: 0 0 70%;
		width: 70%;
		background: #aa9900;
	}

	.contact-drawer__btn--cancel {
		flex: 0 0 30%;
		width: 30%;
		background: #6a6a6a;
	}
</style>

<script>
	// @ts-nocheck
	const drawer = document.getElementById('contact-drawer');
	const backdrop = document.getElementById('contact-drawer-backdrop');
	const form = drawer?.querySelector('[data-contact-form]');
	const cancelBtn = drawer?.querySelector('[data-contact-cancel]');
	const toEmail = 'mauricioatenciam@gmail.com';

	function getScrollContainer() {
		return document.querySelector('.horizontal-scroll-container');
	}

	function getContactSlide() {
		return document.getElementById('contact');
	}

	function stayOnContact() {
		const contact = getContactSlide();
		const container = getScrollContainer();
		if (!(contact instanceof HTMLElement) || !(container instanceof HTMLElement)) return;
		container.scrollLeft = contact.offsetLeft;
	}

	function isContactActive() {
		const contact = getContactSlide();
		const container = getScrollContainer();
		if (!(contact instanceof HTMLElement) || !(container instanceof HTMLElement)) {
			return location.hash === '#contact';
		}
		return Math.abs(contact.offsetLeft - container.scrollLeft) < contact.offsetWidth * 0.35;
	}

	function isDrawerOpen() {
		return drawer instanceof HTMLElement && drawer.classList.contains('is-open');
	}

	function openDrawer() {
		if (!(drawer instanceof HTMLElement)) return;
		stayOnContact();
		drawer.hidden = false;
		drawer.setAttribute('aria-hidden', 'false');
		if (backdrop instanceof HTMLElement) {
			backdrop.hidden = false;
			backdrop.setAttribute('aria-hidden', 'false');
		}
		requestAnimationFrame(() => {
			stayOnContact();
			drawer.classList.add('is-open');
			backdrop?.classList.add('is-open');
			const input = drawer.querySelector('input[name="from"]');
			if (input instanceof HTMLInputElement) {
				input.focus({ preventScroll: true });
			}
			stayOnContact();
		});
	}

	function closeDrawer() {
		if (!(drawer instanceof HTMLElement) || !isDrawerOpen()) return;
		drawer.classList.remove('is-open');
		drawer.setAttribute('aria-hidden', 'true');
		backdrop?.classList.remove('is-open');
		backdrop?.setAttribute('aria-hidden', 'true');
		const onEnd = (event) => {
			if (event.target !== drawer) return;
			drawer.hidden = true;
			if (backdrop instanceof HTMLElement) backdrop.hidden = true;
			drawer.removeEventListener('transitionend', onEnd);
			stayOnContact();
		};
		drawer.addEventListener('transitionend', onEnd);
	}

	window.openContactDrawer = openDrawer;
	window.closeContactDrawer = closeDrawer;

	cancelBtn?.addEventListener('click', (event) => {
		event.preventDefault();
		closeDrawer();
	});

	backdrop?.addEventListener('click', () => closeDrawer());

	drawer?.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') {
			event.preventDefault();
			closeDrawer();
		}
	});

	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		if (!(form instanceof HTMLFormElement)) return;
		const data = new FormData(form);
		const from = String(data.get('from') || '').trim();
		const message = String(data.get('message') || '').trim();
		if (!from || !message) return;

		const body = `From: ${from}\n\n${message}`;
		const mailto = `mailto:${toEmail}?body=${encodeURIComponent(body)}`;
		window.open(mailto, '_self');
		closeDrawer();
		stayOnContact();
	});

	document.addEventListener(
		'click',
		(event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;

			const emailLink = target.closest('[data-open-contact-drawer]');
			if (emailLink) {
				event.preventDefault();
				event.stopPropagation();
				openDrawer();
				return;
			}

			const contactNav = target.closest('a[href="#contact"]');
			if (contactNav && isContactActive()) {
				event.preventDefault();
				event.stopPropagation();
				openDrawer();
			}
		},
		true,
	);
</script>
