---
import siteSettings from '../content/site_settings.json';

const logoText = siteSettings.logo_text || 'Mauricio Atencia';
const logoImage = siteSettings.logo_image;
---

{logoImage ? (
	<img src={logoImage} alt={logoText} class="site-logo-img" decoding="async" />
) : (
	<>{logoText}</>
)}

<style>
	.site-logo-img {
		height: 1em;
		width: auto;
		display: inline-block;
		vertical-align: middle;
		object-fit: contain;
	}
</style>
