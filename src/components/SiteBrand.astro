---
import siteSettings from '../content/site_settings.json';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
const logoText = siteSettings.logo_text || 'Mauricio Atencia';
const logoImage = siteSettings.logo_image;
---

<a href="/" class={className} aria-label="Ir al inicio">
	{logoImage ? (
		<img src={logoImage} alt={logoText} class="site-logo-img" />
	) : (
		logoText
	)}
</a>

<style>
	.site-logo-img {
		height: 1em;
		width: auto;
		display: inline-block;
		vertical-align: middle;
		object-fit: contain;
	}
</style>
