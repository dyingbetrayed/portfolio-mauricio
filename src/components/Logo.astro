---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<a href="/" class:list={['site-logo', className]} aria-label="La Ficha">
	<img
		src="/LA-FICHA-LOGO.png"
		alt="La Ficha"
		width="283"
		height="83"
	/>
</a>

<style>
	.site-logo {
		display: none !important;
		flex-shrink: 0;
		line-height: 0;
	}

	.site-logo img {
		width: var(--logo-w);
		height: auto;
		aspect-ratio: 283 / 83;
		object-fit: contain;
		display: block;
	}
</style>
