---
import Navbar from './Navbar.astro';
import ContactDrawer from './ContactDrawer.astro';
---

<section class="slide contact-slide" id="contact">
	<header class="slide-header contact-header">
		<Navbar theme="dark" active="contact" showLogo />
	</header>
	
	<div class="contact-content-wrapper">
		<div class="contact-title-container">
			<h1 class="contact-title">
				<span>H</span>
				<span>A</span>
				<span>B</span>
				<span>L</span>
				<span>E</span>
				<span>M</span>
				<span>O</span>
				<span>S</span>
			</h1>
		</div>
		
		<footer class="contact-footer">
			<div class="footer-col left-col">
				<a href="/" class="footer-link">Instagram</a>
				<a href="https://wa.me/573146253071" class="footer-link">WhatsApp</a>
			</div>
			
			<div class="footer-col center-col">
				<a
					href="mailto:mauricioatenciam@gmail.com"
					class="footer-link"
					data-open-contact-drawer
				>
					mauricioatenciam@gmail.com
				</a>
			</div>
			
			<div class="footer-col right-col">
				<a href="/" class="footer-link">Behance</a>
				<span class="footer-link">+57 314 625 3071</span>
			</div>
		</footer>
	</div>

	<ContactDrawer />
</section>

<style>
	.contact-slide {
		flex: 0 0 100vw;
		width: 100vw;
		height: 100vh;
		scroll-snap-align: start;
		position: relative;
		overflow: hidden;
		box-sizing: border-box;

		background-color: #eeedec;
		color: #000000;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}

	.contact-header {
		position: relative;
		z-index: 2;
		padding: 1.5rem 3rem 0 2rem;
		display: flex;
		align-items: center;
		width: 100%;
		box-sizing: border-box;
		justify-content: flex-end;
	}

	.contact-content-wrapper {
		display: flex;
		flex-direction: column;
		flex: 1;
		padding: 0 4rem 3rem 4rem;
		box-sizing: border-box;
		width: 100%;
		justify-content: flex-end;
	}

	.contact-title-container {
		width: 100%;
		display: block;
		margin-bottom: 1.5rem;
		container-type: inline-size;
	}

	.contact-title {
		font-family: var(--font-text);
		font-size: 18cqw; 
		font-weight: 700;
		line-height: 0.75;
		margin: 0;
		color: #000000;
		display: flex;
		justify-content: space-between;
		width: 100%;
		white-space: nowrap;
		/* Compensa el sidebearing de la tinta, igual que branding */
		--title-ink-lsb: 0.0854em;
		--title-ink-rsb: 0.05em;
	}

	.contact-title span:first-child {
		margin-left: calc(-1 * var(--title-ink-lsb));
	}

	.contact-title span:last-child {
		margin-right: calc(-1 * var(--title-ink-rsb));
	}

	.contact-footer {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		width: 100%;
		font-family: var(--font-helvetica);
		font-weight: 300;
		font-size: 1rem;
		letter-spacing: 0.5px;
	}

	.footer-col {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.left-col {
		align-items: flex-start;
	}

	.center-col {
		align-items: center;
		text-align: center;
	}

	.right-col {
		align-items: flex-end;
		text-align: right;
	}

	.footer-link {
		color: #000000;
		text-decoration: none;
		transition: opacity 0.2s ease;
	}

	.footer-link:hover {
		opacity: 0.6;
	}
</style>
