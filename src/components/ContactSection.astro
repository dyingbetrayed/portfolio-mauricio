---
import Navbar from './Navbar.astro';
import ContactDrawer from './ContactDrawer.astro';
---

<section class="slide contact-slide" id="contact">
	<header class="slide-header contact-header reveal" style="--reveal-delay: 60ms">
		<a href="/" class="contact__name-title" aria-label="Ir al inicio">Mauricio Atencia</a>
		<Navbar theme="dark" active="contact" />
	</header>
	
	<div class="contact-content-wrapper" data-v-scroll>
		<div class="contact-title-container reveal" style="--reveal-delay: 140ms">
			<h1 class="contact-title">
				<span>H</span>
				<span>A</span>
				<span>B</span>
				<span>L</span>
				<span>E</span>
				<span>M</span>
				<span>O</span>
				<span>S</span>
			</h1>
		</div>
		
		<footer class="contact-footer reveal" style="--reveal-delay: 280ms">
			<div class="footer-col left-col">
				<a href="/" class="footer-link">Instagram</a>
				<a href="https://api.whatsapp.com/send/?phone=573146253071&text&type=phone_number&app_absent=0" class="footer-link">WhatsApp</a>
			</div>
			
			<div class="footer-col center-col">
				<a
					href="mailto:mauricioatenciam@gmail.com"
					class="footer-link"
					data-open-contact-drawer
				>
					mauricioatenciam@gmail.com
				</a>
			</div>
			
			<div class="footer-col right-col">
				<a href="/" class="footer-link">Behance</a>
				<span class="footer-link footer-phone">+57 314 625 3071</span>
			</div>
		</footer>
	</div>

	<ContactDrawer />
</section>

<style>
	.contact-slide {
		flex: 0 0 100vw;
		width: 100vw;
		height: 100vh;
		height: 100dvh;
		scroll-snap-align: start;
		position: relative;
		overflow: hidden;
		box-sizing: border-box;

		background-color: #eeedec;
		color: #000000;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}

	.contact-header {
		position: relative;
		z-index: 2;
		flex: 0 0 auto;
		padding: var(--pad-header-y) var(--pad-header-x-r) 0.35rem var(--pad-header-x-l);
		display: flex;
		align-items: flex-start;
		width: 100%;
		box-sizing: border-box;
		justify-content: space-between;
		gap: clamp(1rem, 2vw, 2rem);
	}

	.contact-header.reveal {
		clip-path: inset(0 0 100% 0);
		transform: translate3d(0, -1.5rem, 0);
	}

	.contact-slide.is-active .contact-header.reveal {
		clip-path: inset(0 0 0 0);
		transform: translate3d(0, 0, 0);
	}

	.contact-header :global(.navbar) {
		width: auto;
		flex: 1;
		min-width: 0;
	}

	.contact__name-title {
		position: absolute;
		left: var(--pad-header-x-l);
		top: var(--pad-header-y);
		z-index: 1;
		margin: 0;
		font-family: var(--font-nav);
		font-weight: 600;
		font-size: clamp(0.85rem, 1.5vw, 1.75rem);
		line-height: 0.95;
		letter-spacing: -0.022em;
		-webkit-text-stroke: clamp(0.5px, 0.035vw, 1px) currentColor;
	}

	.contact__name-title:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 0.18em;
	}

	.contact-content-wrapper {
		display: flex;
		flex-direction: column;
		flex: 1;
		min-height: 0;
		padding: 0 var(--pad-section-x-r) var(--pad-section-b) var(--pad-section-x-l);
		box-sizing: border-box;
		width: 100%;
		justify-content: flex-end;
		overflow-x: hidden;
		overflow-y: auto;
		overscroll-behavior: contain;
		-webkit-overflow-scrolling: touch;
		touch-action: pan-y;
	}

	.contact-title-container {
		width: 100%;
		display: block;
		/* Reserva el ascenso de las mayúsculas dentro de la máscara reveal. */
		padding-top: clamp(0.5rem, 2.8vw, 3rem);
		margin-bottom: clamp(0.75rem, 2vh, 1.5rem);
		container-type: inline-size;
	}

	.contact-title {
		font-family: var(--font-text);
		font-size: 18cqw; 
		font-weight: 700;
		font-style: normal;
		font-synthesis: none;
		/* Evita que Safari móvil active el eje variable de inclinación. */
		font-variation-settings: 'wght' 700, 'wdth' 100, 'slnt' 0;
		line-height: 0.75;
		margin: 0;
		color: #000000;
		display: flex;
		justify-content: space-between;
		width: 100%;
		white-space: nowrap;
		/* Compensa el sidebearing de la tinta, igual que branding */
		--title-ink-lsb: 0.0854em;
		--title-ink-rsb: 0.05em;
	}

	.contact-title span {
		display: inline-block;
		opacity: 0;
		transform: translate3d(0, -0.55em, 0);
		transition:
			opacity var(--dur-med, 0.55s) var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)),
			transform var(--dur-med, 0.55s) var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1));
	}

	.contact-slide.is-active .contact-title span {
		opacity: 1;
		transform: translate3d(0, 0, 0);
	}

	.contact-title span:nth-child(1) { transition-delay: 90ms; }
	.contact-title span:nth-child(2) { transition-delay: 140ms; }
	.contact-title span:nth-child(3) { transition-delay: 190ms; }
	.contact-title span:nth-child(4) { transition-delay: 240ms; }
	.contact-title span:nth-child(5) { transition-delay: 290ms; }
	.contact-title span:nth-child(6) { transition-delay: 340ms; }
	.contact-title span:nth-child(7) { transition-delay: 390ms; }
	.contact-title span:nth-child(8) { transition-delay: 440ms; }

	.contact-title span:first-child {
		margin-left: calc(-1 * var(--title-ink-lsb));
	}

	.contact-title span:last-child {
		margin-right: calc(-1 * var(--title-ink-rsb));
	}

	.contact-footer {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		width: 100%;
		font-family: var(--font-helvetica);
		font-weight: 300;
		font-style: normal;
		font-synthesis: none;
		font-size: clamp(0.7rem, 1.35vh + 0.35vw, 1rem);
		letter-spacing: 0.5px;
		gap: 0.75rem;
	}

	.footer-col {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.left-col {
		align-items: flex-start;
	}

	.center-col {
		align-items: center;
		text-align: center;
	}

	.right-col {
		align-items: flex-end;
		text-align: right;
	}

	.footer-link {
		color: #000000;
		text-decoration: none;
		transition: opacity var(--dur-fast, 0.32s) var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1));
	}

	.footer-link:hover {
		opacity: 0.6;
	}

	@media (max-width: 900px) {
		.contact__name-title {
			font-size: clamp(1.5rem, 10vw, 3.5rem);
			-webkit-text-stroke: clamp(1px, 0.07vw, 2px) currentColor;
		}
		@supports (height: 1dvh) {
			.contact__name-title {
				font-size: clamp(1.5rem, min(10vw, 7dvh), 3.5rem);
			}
		}
	}

	@media (max-width: 700px) {
		.contact-slide {
			flex: 0 0 100dvh;
			width: 100%;
		}

		.contact-header.reveal,
		.contact-slide.is-active .contact-header.reveal {
			clip-path: none;
			transform: none;
			transition: opacity 80ms linear 60ms;
		}

		.contact__name-title {
			font-size: clamp(1rem, 4.2vw, 1.2rem);
			top: calc(var(--pad-header-y) + 0.9rem);
		}

		.contact-content-wrapper {
			justify-content: center;
		}

		.contact-title {
			font-size: min(16cqw, 4.25rem);
		}

		.contact-title-container {
			margin-bottom: clamp(0.25rem, 0.6vh, 0.45rem);
		}

		.contact-footer {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			grid-template-rows: repeat(3, auto);
			align-items: start;
			column-gap: 1rem;
			row-gap: 0.35rem;
			font-size: clamp(0.85rem, 3.6vw, 1rem);
		}

		.left-col,
		.right-col {
			display: contents;
		}

		.center-col {
			grid-column: 1 / -1;
			grid-row: 1;
			align-items: center;
			text-align: center;
			justify-self: center;
			margin-bottom: 0.5rem;
		}

		.left-col .footer-link:first-child {
			grid-column: 1;
			grid-row: 2;
			justify-self: start;
		}

		.right-col .footer-link:first-child {
			grid-column: 2;
			grid-row: 2;
			justify-self: end;
		}

		.left-col .footer-link:last-child {
			grid-column: 2;
			grid-row: 3;
			justify-self: end;
		}

		.footer-phone {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-title span {
			opacity: 1;
			transform: none;
			transition: none;
		}
	}

</style>
