---
import { projectCategories } from '../data/projects';
import type { Project, ProjectCategory } from '../data/projects';

export function getStaticPaths() {
	const paths: { params: { id: string }; props: { type: 'category' | 'project'; data: Project | ProjectCategory; slug: string } }[] = [];

	Object.entries(projectCategories).forEach(([categoryId, category]) => {
		// Agrega la categoría
		paths.push({
			params: { id: categoryId },
			props: { type: 'category', data: category, slug: categoryId }
		});

		// Agrega los proyectos de esta categoría
		category.projects.forEach(project => {
			paths.push({
				params: { id: project.slug },
				props: { type: 'project', data: project, slug: project.slug }
			});
		});
	});

	return paths;
}

interface Props {
	type: 'category' | 'project';
	data: Project | ProjectCategory;
	slug: string;
}

const { type, data, slug } = Astro.props;
const BASE_URL = 'https://portfolio-mauricio-beta.vercel.app';
const redirectUrl = `${BASE_URL}/#${slug}`;

let ogImage = `${BASE_URL}/LA-FICHA-LOGO.png`;
let ogTitle = '';
let ogDescription = '';

if (type === 'project') {
	const project = data as Project;
	ogImage = project.images?.[0]
		? `${BASE_URL}${project.images[0]}`
		: ogImage;
	ogTitle = project.name;
	ogDescription = project.tagline
		? project.tagline.replace(/\\n/g, ' ')
		: `${project.name} — Proyecto de diseño por Mauricio Atencia${project.year ? ` (${project.year})` : ''}`;
} else {
	const category = data as ProjectCategory;
	// Buscamos la primera imagen del primer proyecto que tenga imágenes
	const firstProjectWithImage = category.projects.find(p => p.images && p.images.length > 0);
	ogImage = firstProjectWithImage?.images?.[0]
		? `${BASE_URL}${firstProjectWithImage.images[0]}`
		: ogImage;
	ogTitle = (category as ProjectCategory).title;
	ogDescription = `Proyectos de ${(category as ProjectCategory).title} — Mauricio Atencia`;
}
---
<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{ogTitle} — Mauricio Atencia</title>

	<!-- Open Graph / WhatsApp / Facebook -->
	<meta property="og:type" content="website" />
	<meta property="og:url" content={`${BASE_URL}/${slug}`} />
	<meta property="og:title" content={`${ogTitle} — Mauricio Atencia`} />
	<meta property="og:description" content={ogDescription} />
	<meta property="og:image" content={ogImage} />
	<meta property="og:image:width" content="1200" />
	<meta property="og:image:height" content="630" />
	<meta property="og:site_name" content="Mauricio Atencia" />
	<meta property="og:locale" content="es_CO" />

	<!-- Twitter / X -->
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={`${ogTitle} — Mauricio Atencia`} />
	<meta name="twitter:description" content={ogDescription} />
	<meta name="twitter:image" content={ogImage} />

	<!-- Redirect non-crawler visitors immediately to the SPA -->
	<meta http-equiv="refresh" content={`0; url=${redirectUrl}`} />
	<link rel="canonical" href={`${BASE_URL}/${slug}`} />
</head>
<body>
	<p>
		Redirigiendo a <a href={redirectUrl}>{ogTitle}</a>…
	</p>
	<script define:vars={{ redirectUrl }}>
		// Instant JS redirect for browsers (faster than meta refresh)
		window.location.replace(redirectUrl);
	</script>
</body>
</html>
