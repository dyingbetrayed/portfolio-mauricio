---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import AboutSection from '../components/AboutSection.astro';
import WorkSlide from '../components/WorkSlide.astro';
import ContactSection from '../components/ContactSection.astro';
---

<Layout>
	<main class="horizontal-scroll-container">
		<section class="slide hero-slide">
			<div class="hero-media" aria-hidden="true"></div>
			<div class="overlay"></div>
			<header class="slide-header hero-header reveal" style="--reveal-delay: 80ms">
				<Navbar theme="light" />
			</header>
			
			<div class="hero-content">
			</div>

			<footer class="hero-footer">
				<p class="hero-description">
					<span class="hero-description__copy">SI TIENES UNA IDEA EN MENTE Y QUIERES DESARROLLAR TU IDEA, PODEMOS TRABAJAR EN TU IDENTIDAD, PACKAGING, FLYER O MERCH.</span>
				</p>
			</footer>

			<button
				type="button"
				class="scroll-hint reveal"
				style="--reveal-delay: 420ms"
				aria-label="Ir a la siguiente sección"
				data-next-slide
				data-cursor-nav
			>
				<div class="scroll-hint__arrow">
					<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
						<path d="M5 12h14M12 5l7 7-7 7"/>
					</svg>
				</div>
			</button>
		</section>

		<AboutSection />

		<WorkSlide />

		<ContactSection />
	</main>
</Layout>

<script>
	// @ts-nocheck
	const container = document.querySelector('.horizontal-scroll-container');
	if (container) {
		/* Astro puede insertar <script> entre componentes: solo las secciones son slides. */
		const slides = () =>
			Array.from(container.querySelectorAll(':scope > section'));

		let currentIndex = 0;
		let isScrolling = false;
		let navigationDirection = 0;
		let navigationTimer = 0;
		let navigationFrame = 0;
		const NAVIGATION_DURATION = 620;
		const NAVIGATION_FALLBACK = NAVIGATION_DURATION + 180;
		const WHEEL_THRESHOLD = 80;
		/* Un touchpad puede seguir emitiendo inercia tras cambiar de slide. */
		const WHEEL_IDLE = 700;
		const TOUCH_INTENT_THRESHOLD = 5;
		const SWIPE_THRESHOLD = 80;
		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		function nearestIndex() {
			const left = container.scrollLeft;
			const list = slides();
			let best = 0;
			let bestDist = Infinity;
			list.forEach((slide, i) => {
				const dist = Math.abs(slide.offsetLeft - left);
				if (dist < bestDist) {
					bestDist = dist;
					best = i;
				}
			});
			return best;
		}

		function setActiveSlide(index) {
			slides().forEach((slide, i) => {
				const on = i === index;
				const wasOn = slide.classList.contains('is-active');
				if (on === wasOn) return;
				slide.classList.toggle('is-active', on);
				if (on) slide.setAttribute('data-active', '');
				else slide.removeAttribute('data-active');
			});
		}

		function finishNavigation() {
			if (navigationFrame) {
				window.cancelAnimationFrame(navigationFrame);
				navigationFrame = 0;
			}
			window.clearTimeout(navigationTimer);
			navigationTimer = 0;
			container.style.removeProperty('scroll-snap-type');
			isScrolling = false;
			navigationDirection = 0;
			currentIndex = nearestIndex();
			setActiveSlide(currentIndex);
			/* Conserva el gesto que originó el cambio hasta que la inercia se agote. */
			if (wheelGestureActive) keepWheelGestureOpen();
		}

		function animateToSlide(left, smooth) {
			if (navigationFrame) {
				window.cancelAnimationFrame(navigationFrame);
				navigationFrame = 0;
			}

			const start = container.scrollLeft;
			const distance = left - start;
			if (!smooth || prefersReducedMotion || Math.abs(distance) <= 2) {
				container.scrollLeft = left;
				return false;
			}

			/* El snap se pausa durante la animaciÃ³n para que no salte entre slides. */
			container.style.scrollSnapType = 'none';
			const startedAt = performance.now();
			const easeInOut = (progress) => -(Math.cos(Math.PI * progress) - 1) / 2;

			const step = (now) => {
				const progress = Math.min(1, (now - startedAt) / NAVIGATION_DURATION);
				container.scrollLeft = start + distance * easeInOut(progress);
				if (progress < 1) {
					navigationFrame = window.requestAnimationFrame(step);
					return;
				}
				navigationFrame = 0;
				finishNavigation();
			};

			navigationFrame = window.requestAnimationFrame(step);
			return true;
		}

		function goToIndex(index, { smooth = true } = {}) {
			const list = slides();
			const next = Math.min(list.length - 1, Math.max(0, index));
			const slide = list[next];
			if (!slide) return false;

			const alreadyThere = Math.abs(container.scrollLeft - slide.offsetLeft) <= 2;
			if (alreadyThere) {
				currentIndex = next;
				setActiveSlide(next);
				return false;
			}

			currentIndex = next;
			isScrolling = true;
			window.clearTimeout(navigationTimer);
			if (animateToSlide(slide.offsetLeft, smooth)) {
				navigationTimer = window.setTimeout(finishNavigation, NAVIGATION_FALLBACK);
			} else {
				finishNavigation();
			}
			return true;
		}

		function go(delta) {
			if (isScrolling) {
				/* Only a reversal can interrupt an in-flight transition. */
				if (delta !== -navigationDirection) return;
				const target = Math.min(slides().length - 1, Math.max(0, currentIndex + delta));
				if (goToIndex(target)) {
					navigationDirection = delta;
					const id = slides()[target]?.id;
					const url = id ? `#${id}` : `${location.pathname}${location.search}`;
					history.replaceState(null, '', url);
				}
				return;
			}
			/* El DOM es la fuente de verdad tras cualquier gesto o animación. */
			const source = nearestIndex();
			const target = Math.min(slides().length - 1, Math.max(0, source + delta));
			if (goToIndex(target)) {
				navigationDirection = delta;
				const id = slides()[target]?.id;
				const url = id ? `#${id}` : `${location.pathname}${location.search}`;
				history.replaceState(null, '', url);
			}
		}

		function workDepth() {
			const work = document.getElementById('work');
			return Number(work?.dataset.depth || 0);
		}

		function indexForHash(hash) {
			const id = hash.replace(/^#/, '');
			if (!id) return 0;
			const list = slides();
			const byId = list.findIndex((el) => el.id === id);
			if (byId !== -1) return byId;
			// Proyectos / categorías viven dentro de #work
			if (document.getElementById(id)?.closest('#work')) {
				return list.findIndex((el) => el.id === 'work');
			}
			return -1;
		}

		function canScrollVertically(el, deltaY) {
			if (!(el instanceof Element)) return false;
			const style = getComputedStyle(el);
			const overflowY = style.overflowY;
			if (overflowY !== 'auto' && overflowY !== 'scroll' && overflowY !== 'overlay') {
				return false;
			}
			const max = el.scrollHeight - el.clientHeight;
			if (max <= 1) return false;
			if (deltaY < 0) return el.scrollTop > 0;
			if (deltaY > 0) return el.scrollTop < max - 1;
			return true;
		}

		function findScrollableParent(start, deltaY) {
			let node = start instanceof Element ? start : null;
			while (node && node !== container) {
				if (
					node.hasAttribute('data-v-scroll') &&
					canScrollVertically(node, deltaY)
				) {
					return node;
				}
				node = node.parentElement;
			}
			return null;
		}

		let wheelGestureActive = false;
		let wheelGestureUsesNestedScroll = false;
		let wheelAccumulator = 0;
		let wheelIdleTimer = 0;

		function resetWheelGesture() {
			/* No liberar un gesto mientras su navegación aún está en curso. */
			if (isScrolling) {
				keepWheelGestureOpen();
				return;
			}
			wheelGestureActive = false;
			wheelGestureUsesNestedScroll = false;
			wheelAccumulator = 0;
		}

		function keepWheelGestureOpen() {
			window.clearTimeout(wheelIdleTimer);
			wheelIdleTimer = window.setTimeout(resetWheelGesture, WHEEL_IDLE);
		}

		container.addEventListener('wheel', (event) => {
			if (workDepth() > 0) return;

			const rawDelta =
				Math.abs(event.deltaY) >= Math.abs(event.deltaX)
					? event.deltaY
					: event.deltaX;
			const deltaScale =
				event.deltaMode === WheelEvent.DOM_DELTA_LINE
					? 16
					: event.deltaMode === WheelEvent.DOM_DELTA_PAGE
						? container.clientWidth
						: 1;
			const primaryDelta = rawDelta * deltaScale;
			if (Math.abs(primaryDelta) < 2) return;
			/* A direction change starts a fresh touchpad gesture immediately. */
			if (wheelAccumulator && Math.sign(wheelAccumulator) !== Math.sign(primaryDelta)) {
				resetWheelGesture();
			}
			const isVertical =
				Math.abs(event.deltaY) >= Math.abs(event.deltaX);

			if (
				isVertical &&
				findScrollableParent(event.target, event.deltaY)
			) {
				wheelGestureUsesNestedScroll = true;
				keepWheelGestureOpen();
				return;
			}

			event.preventDefault();
			keepWheelGestureOpen();

			/* No encadenar el final de un scroll vertical con otro salto horizontal. */
			if (wheelGestureUsesNestedScroll) return;

			/* La inercia completa del touchpad pertenece a un solo gesto. */
			if (wheelGestureActive) return;
			wheelAccumulator += primaryDelta;
			if (Math.abs(wheelAccumulator) < WHEEL_THRESHOLD) return;

			wheelGestureActive = true;
			go(wheelAccumulator > 0 ? 1 : -1);
		}, { passive: false });

		/* ── Touch: un controlador para pan horizontal y swipe vertical ── */
		let touchGesture = null;

		container.addEventListener('touchstart', (event) => {
			if (event.touches.length !== 1) {
				touchGesture = null;
				return;
			}
			const touch = event.touches[0];
			const target = event.target;
			touchGesture = {
				startX: touch.clientX,
				startY: touch.clientY,
				startIndex: nearestIndex(),
				axis: null,
				navigates: false,
				scrollTarget: target instanceof Element ? target.closest('[data-v-scroll]') : null,
			};
		}, { passive: true });

		container.addEventListener('touchmove', (event) => {
			if (!touchGesture || event.touches.length !== 1) return;
			const touch = event.touches[0];
			const dx = touch.clientX - touchGesture.startX;
			const dy = touch.clientY - touchGesture.startY;
			const depth = workDepth();

			if (!touchGesture.axis) {
				if (Math.max(Math.abs(dx), Math.abs(dy)) < TOUCH_INTENT_THRESHOLD) {
					/* Even before determining axis, prevent default on horizontal moves to block the browser gesture */
					if (Math.abs(dx) > Math.abs(dy) && event.cancelable) event.preventDefault();
					return;
				}
				touchGesture.axis = Math.abs(dx) > Math.abs(dy) ? 'x' : 'y';
				if (touchGesture.axis === 'x') {
					touchGesture.navigates = depth === 0;
				} else {
					touchGesture.navigates = depth === 0 && !canScrollVertically(touchGesture.scrollTarget, -dy);
				}
			}

			/* Always block horizontal touches globally to prevent browser history navigation */
			if (touchGesture.axis === 'x' && event.cancelable) event.preventDefault();
			else if (touchGesture.navigates && event.cancelable) event.preventDefault();
		}, { passive: false });

		container.addEventListener('touchend', (event) => {
			if (!touchGesture) {
				return;
			}
			const depth = workDepth();
			if (depth > 0) {
				touchGesture = null;
				return;
			}
			const gesture = touchGesture;
			const touch = event.changedTouches[0];
			const dx = touch.clientX - gesture.startX;
			const dy = touch.clientY - gesture.startY;
			const distance = gesture.axis === 'x' ? dx : dy;
			const shouldNavigate =
				gesture.navigates &&
				!isScrolling &&
				Math.abs(distance) >= SWIPE_THRESHOLD;
			touchGesture = null;
			if (!shouldNavigate) return;

			/*
			 * Safari y algunos navegadores Android pueden avanzar el scroll nativo
			 * antes de que el touchend llegue. Volvemos al slide donde empezó el
			 * gesto para que animateToSlide siempre tenga distancia que recorrer.
			 */
			const delta = distance < 0 ? 1 : -1;
			const list = slides();
			const startSlide = list[gesture.startIndex];
			const targetIndex = Math.min(
				list.length - 1,
				Math.max(0, gesture.startIndex + delta),
			);
			if (!startSlide || targetIndex === gesture.startIndex) return;

			container.style.scrollSnapType = 'none';
			container.scrollLeft = startSlide.offsetLeft;
			currentIndex = gesture.startIndex;
			setActiveSlide(currentIndex);

			if (goToIndex(targetIndex)) {
				navigationDirection = delta;
				const id = list[targetIndex]?.id;
				const url = id ? `#${id}` : `${location.pathname}${location.search}`;
				history.replaceState(null, '', url);
			} else {
				container.style.removeProperty('scroll-snap-type');
			}
		}, { passive: true });

		container.addEventListener('touchcancel', () => {
			touchGesture = null;
		}, { passive: true });

		/* ── Keyboard navigation ── */
		window.addEventListener('keydown', (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			const tag = target.tagName;
			if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
			if (target instanceof HTMLElement && target.isContentEditable) return;

			const isNext = event.key === 'ArrowRight' || event.key === 'ArrowDown';
			const isPrev = event.key === 'ArrowLeft' || event.key === 'ArrowUp';
			if (!isNext && !isPrev) return;
			if (event.repeat) {
				event.preventDefault();
				return;
			}

			const depth = workDepth();
			if (depth > 0) {
				if (event.key === 'ArrowLeft') {
					event.preventDefault();
					document.getElementById('work')?.dispatchEvent(new CustomEvent('work:back'));
				} else if (event.key === 'ArrowRight') {
					event.preventDefault();
					document.getElementById('work')?.dispatchEvent(new CustomEvent('work:forward'));
				}
				return;
			}

			event.preventDefault();
			go(isNext ? 1 : -1);
		});

		/* ── Navbar / hash → misma navegación horizontal ── */
		document.addEventListener('click', (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			const externalControl = target.closest('[data-external-url]');
			if (externalControl instanceof HTMLElement) {
				const url = externalControl.getAttribute('data-external-url');
				if (!url) return;
				event.preventDefault();
				window.open(url, '_blank', 'noopener,noreferrer');
				return;
			}
			const link = target.closest('a[href^="#"]');
			if (!(link instanceof HTMLAnchorElement)) return;
			const href = link.getAttribute('href');
			if (!href || href === '#') return;

			const idx = indexForHash(href);
			if (idx < 0) return;

			event.preventDefault();
			if (workDepth() > 0 && href !== '#work') {
				document.getElementById('work')?.dispatchEvent(new CustomEvent('work:close'));
			}
			goToIndex(idx);
			history.replaceState(null, '', href);
		});

		container.addEventListener('scroll', () => {
			const idx = nearestIndex();
			if (!isScrolling) currentIndex = idx;
			/* Durante el swipe, activar cuando el slide ya es el más cercano */
			setActiveSlide(idx);
		}, { passive: true });

		container.addEventListener('scrollend', () => {
			if (isScrolling) {
				if (!navigationFrame) finishNavigation();
				return;
			}
			currentIndex = nearestIndex();
			setActiveSlide(currentIndex);
		}, { passive: true });

		/* ── Scroll hint: hide on first interaction ── */
		const scrollHint = document.querySelector('.scroll-hint');
		if (scrollHint) {
			const hideHint = () => {
				scrollHint.classList.add('is-hidden');
				container.removeEventListener('scroll', hideHint);
				window.removeEventListener('keydown', hideHint);
			};
			scrollHint.addEventListener('click', () => go(1));
			container.addEventListener('scroll', hideHint, { once: true });
			window.addEventListener('keydown', hideHint, { once: true });
		}

		currentIndex = nearestIndex();
		const initialHash = indexForHash(location.hash);
		if (initialHash >= 0) {
			const list = slides();
			const slide = list[initialHash];
			if (slide) {
				currentIndex = initialHash;
				container.scrollTo({ left: slide.offsetLeft, behavior: 'instant' });
			}
		}

		/* Primero pinta el estado inicial (opacity 0), luego activa el fade-up */
		slides().forEach((slide) => {
			slide.classList.remove('is-active');
			slide.removeAttribute('data-active');
		});

		if (prefersReducedMotion) {
			setActiveSlide(currentIndex);
		} else {
			requestAnimationFrame(() => {
				requestAnimationFrame(() => {
					setActiveSlide(currentIndex);
				});
			});
		}
	}
</script>

<style>
	.horizontal-scroll-container {
		display: flex;
		flex-direction: row;
		width: 100vw;
		height: 100vh;
		height: 100dvh;
		overflow-x: auto;
		overflow-y: hidden;
		scroll-snap-type: x mandatory;
		scroll-behavior: auto;
		touch-action: pan-y;
		overscroll-behavior: none;
		-ms-overflow-style: none;
		scrollbar-width: none;
	}

	:global(.horizontal-scroll-container > section) {
		scroll-snap-stop: always;
	}

	/* Dentro de capas Work: no pelear el pan vertical del panel */
	.horizontal-scroll-container.is-v-nested {
		overflow-x: hidden;
		touch-action: pan-y;
		overscroll-behavior: none;
	}
	
	.horizontal-scroll-container::-webkit-scrollbar {
		display: none;
	}

	.slide {
		flex: 0 0 100vw;
		width: 100vw;
		height: 100vh;
		height: 100dvh;
		scroll-snap-align: start;
		position: relative;
		display: flex;
		flex-direction: column;
		box-sizing: border-box;
		overflow: hidden;
	}

	.slide-header {
		position: relative;
		z-index: 2;
		padding: var(--pad-header-y) var(--pad-header-x-r) 0.35rem var(--pad-header-x-l);
		display: flex;
		align-items: center;
		width: 100%;
		box-sizing: border-box;
	}

	.hero-header {
		justify-content: flex-end;
	}

	.hero-slide {
		background-color: #050505;
		justify-content: space-between;
	}

	.hero-media {
		position: absolute;
		inset: 0;
		z-index: 0;
		background: url('/index/1.jpg') center / cover no-repeat;
		/* Parte de un cuadrado central y crece hacia los cuatro bordes. */
		clip-path: inset(50% 50% 50% 50%);
		will-change: clip-path;
		transition: clip-path var(--dur-slow) var(--ease-out);
	}

	.hero-slide.is-active .hero-media {
		clip-path: inset(0 0 0 0);
	}

	.hero-slide .overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: rgba(0, 0, 0, 0.15);
		z-index: 1;
		pointer-events: none;
		opacity: 0.25;
		transition: opacity var(--dur-slow) var(--ease-out) 90ms;
	}

	.hero-slide.is-active .overlay {
		opacity: 0.82;
	}

	/* La navegación cae desde el borde superior una vez que el fondo abre. */
	.hero-header.reveal {
		clip-path: inset(0 0 100% 0);
		transform: translate3d(0, -2.25rem, 0);
		transition-delay: 260ms;
	}

	.hero-slide.is-active .hero-header.reveal {
		clip-path: inset(0 0 0 0);
		transform: translate3d(0, 0, 0);
	}

	.hero-content, .hero-footer {
		position: relative;
		z-index: 2;
	}

	.hero-footer {
		padding: clamp(1rem, 3vh, 2rem) var(--pad-section-x-r) var(--pad-section-b) var(--pad-section-x-l);
		display: flex;
		justify-content: center;
		text-align: center;
	}

	.hero-description {
		margin: 0;
		width: min(70%, 52rem);
		overflow: hidden;
		padding: 0.08em 0;
	}

	.hero-description__copy {
		display: block;
		font-family: var(--font-text);
		font-weight: 700;
		font-size: clamp(
			calc(0.75rem + 2px),
			calc(1.35vh + 0.35vw + 2px),
			calc(1rem + 2px)
		);
		max-width: none;
		letter-spacing: 1px;
		line-height: 1.6;
		color: #f4f4f4;
		transform: translate3d(0, -112%, 0);
		transition: transform var(--dur-med) var(--ease-out) 460ms;
		will-change: transform;
	}

	.hero-slide.is-active .hero-description__copy {
		transform: translate3d(0, 0, 0);
	}

	:global(html:not(.js)) .hero-description__copy {
		transform: none;
		transition: none;
	}

	.scroll-hint {
		position: absolute;
		top: 50%;
		right: var(--pad-header-x-r);
		transform: translateY(-50%);
		z-index: 3;
		display: flex;
		align-items: center;
		justify-content: center;
		color: rgba(255, 255, 255, 0.8);
		transition: opacity var(--dur-med) var(--ease-out);
		padding: 0;
		border: none;
		background: transparent;
		cursor: pointer;
	}

	.scroll-hint:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 0.35rem;
	}

	.scroll-hint.is-hidden {
		opacity: 0 !important;
		pointer-events: none;
		transform: translateY(-50%) !important;
	}

	.scroll-hint__arrow {
		display: flex;
		align-items: center;
		justify-content: center;
		animation: hint-bounce-x 2s cubic-bezier(0.28, 0.84, 0.42, 1) infinite;
	}

	@keyframes hint-bounce-x {
		0%, 100% { transform: translateX(0); }
		50% { transform: translateX(8px); }
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-media {
			clip-path: none;
			transition: none;
		}

		.scroll-hint__arrow {
			animation: none;
		}

		.hero-description__copy {
			transform: none;
			transition: none;
		}
	}
</style>
