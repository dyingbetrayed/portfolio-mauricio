---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import AboutSection from '../components/AboutSection.astro';
import WorkSlide from '../components/WorkSlide.astro';
import ContactSection from '../components/ContactSection.astro';
---

<Layout>
	<main class="horizontal-scroll-container">
		<section class="slide hero-slide">
			<div class="overlay"></div>
			<header class="slide-header hero-header">
				<Navbar theme="light" />
			</header>
			
			<div class="hero-content">
			</div>

			<footer class="hero-footer">
				<p>SI TIENES UNA IDEA EN MENTE Y QUIERES DESARROLLAR TU IDEA, PODEMOS TRABAJAR EN TU IDENTIDAD, PACKAGING, FLYER O MERCH.</p>
			</footer>

			<div class="scroll-hint" aria-hidden="true">
				<span class="scroll-hint__text">Scroll</span>
				<span class="scroll-hint__arrow">→</span>
			</div>
		</section>

		<AboutSection />

		<WorkSlide />

		<ContactSection />
	</main>
</Layout>

<script>
	// @ts-nocheck
	const container = document.querySelector('.horizontal-scroll-container');
	if (container) {
		const slides = () =>
			Array.from(container.children).filter((el) => el.nodeType === 1);

		let currentIndex = 0;
		let isScrolling = false;
		const SCROLL_COOLDOWN = 650;

		function nearestIndex() {
			const left = container.scrollLeft;
			const list = slides();
			let best = 0;
			let bestDist = Infinity;
			list.forEach((slide, i) => {
				const dist = Math.abs(slide.offsetLeft - left);
				if (dist < bestDist) {
					bestDist = dist;
					best = i;
				}
			});
			return best;
		}

		function goToIndex(index, { smooth = true } = {}) {
			const list = slides();
			const next = Math.min(list.length - 1, Math.max(0, index));
			const slide = list[next];
			if (!slide) return;

			currentIndex = next;
			isScrolling = true;
			container.scrollTo({
				left: slide.offsetLeft,
				behavior: smooth ? 'smooth' : 'instant',
			});
			window.setTimeout(() => {
				isScrolling = false;
				currentIndex = nearestIndex();
			}, SCROLL_COOLDOWN);
		}

		function go(delta) {
			if (isScrolling) return;
			goToIndex(currentIndex + delta);
		}

		function workDepth() {
			const work = document.getElementById('work');
			return Number(work?.dataset.depth || 0);
		}

		function indexForHash(hash) {
			const id = hash.replace(/^#/, '');
			if (!id) return 0;
			const list = slides();
			const byId = list.findIndex((el) => el.id === id);
			if (byId !== -1) return byId;
			// Proyectos / categorías viven dentro de #work
			if (document.getElementById(id)?.closest('#work')) {
				return list.findIndex((el) => el.id === 'work');
			}
			return -1;
		}

		/* ── Wheel → horizontal (debounced snap) ── */
		container.addEventListener('wheel', (event) => {
			if (workDepth() > 0) return;
			if (Math.abs(event.deltaY) < 5 && Math.abs(event.deltaX) < 5) return;
			event.preventDefault();
			if (isScrolling) return;
			const delta = Math.abs(event.deltaY) >= Math.abs(event.deltaX)
				? event.deltaY
				: event.deltaX;
			go(delta > 0 ? 1 : -1);
		}, { passive: false });

		/* ── Touch swipe → horizontal ── */
		let touchStartX = 0;
		let touchStartY = 0;
		const SWIPE_THRESHOLD = 50;

		container.addEventListener('touchstart', (event) => {
			if (workDepth() > 0) return;
			const touch = event.touches[0];
			touchStartX = touch.clientX;
			touchStartY = touch.clientY;
		}, { passive: true });

		container.addEventListener('touchend', (event) => {
			if (workDepth() > 0) return;
			if (isScrolling) return;
			const touch = event.changedTouches[0];
			const dx = touch.clientX - touchStartX;
			const dy = touch.clientY - touchStartY;
			if (Math.abs(dx) < SWIPE_THRESHOLD || Math.abs(dy) > Math.abs(dx)) return;
			go(dx < 0 ? 1 : -1);
		}, { passive: true });

		/* ── Keyboard navigation ── */
		window.addEventListener('keydown', (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			const tag = target.tagName;
			if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
			if (target instanceof HTMLElement && target.isContentEditable) return;

			const isNext = event.key === 'ArrowRight' || event.key === 'ArrowDown';
			const isPrev = event.key === 'ArrowLeft' || event.key === 'ArrowUp';
			if (!isNext && !isPrev) return;

			const depth = workDepth();
			if (depth > 0) {
				event.preventDefault();
				if (isPrev) {
					document.getElementById('work')?.dispatchEvent(new CustomEvent('work:back'));
				}
				return;
			}

			event.preventDefault();
			go(isNext ? 1 : -1);
		});

		/* ── Navbar / hash → misma navegación horizontal ── */
		document.addEventListener('click', (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			const link = target.closest('a[href^="#"]');
			if (!(link instanceof HTMLAnchorElement)) return;
			const href = link.getAttribute('href');
			if (!href || href === '#') return;

			const idx = indexForHash(href);
			if (idx < 0) return;

			event.preventDefault();
			if (workDepth() > 0 && href !== '#work') {
				document.getElementById('work')?.dispatchEvent(new CustomEvent('work:close'));
			}
			goToIndex(idx);
			history.replaceState(null, '', href);
		});

		container.addEventListener('scroll', () => {
			if (!isScrolling) currentIndex = nearestIndex();
		}, { passive: true });

		/* ── Scroll hint: hide on first interaction ── */
		const scrollHint = document.querySelector('.scroll-hint');
		if (scrollHint) {
			const hideHint = () => {
				scrollHint.classList.add('is-hidden');
				container.removeEventListener('scroll', hideHint);
				window.removeEventListener('keydown', hideHint);
			};
			container.addEventListener('scroll', hideHint, { once: true });
			window.addEventListener('keydown', hideHint, { once: true });
		}

		currentIndex = nearestIndex();
		const initialHash = indexForHash(location.hash);
		if (initialHash >= 0) goToIndex(initialHash, { smooth: false });
	}
</script>

<style>
	.horizontal-scroll-container {
		display: flex;
		flex-direction: row;
		width: 100vw;
		height: 100vh;
		overflow-x: auto;
		overflow-y: hidden;
		scroll-snap-type: x mandatory;
		scroll-behavior: smooth;
		-ms-overflow-style: none;
		scrollbar-width: none;
	}
	
	.horizontal-scroll-container::-webkit-scrollbar {
		display: none;
	}

	.slide {
		flex: 0 0 100vw;
		width: 100vw;
		height: 100vh;
		scroll-snap-align: start;
		position: relative;
		display: flex;
		flex-direction: column;
		box-sizing: border-box;
		overflow: hidden;
	}

	.slide-header {
		position: relative;
		z-index: 2;
		padding: 1.5rem 3rem 0 2rem;
		display: flex;
		align-items: center;
		width: 100%;
		box-sizing: border-box;
	}

	.hero-header {
		justify-content: flex-end;
	}

	.hero-slide {
		background-image: url('/index/1.jpg');
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		justify-content: space-between;
	}

	.hero-slide .overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: rgba(0, 0, 0, 0.15);
		z-index: 1;
		pointer-events: none;
	}

	.hero-content, .hero-footer {
		position: relative;
		z-index: 2;
	}

	.hero-footer {
		padding: 2rem 4rem 2rem 4rem;
		display: flex;
		justify-content: center;
		text-align: center;
	}

	.hero-footer p {
		font-family: var(--font-text);
		font-weight: 300;
		font-size: 1rem;
		max-width: 70%;
		letter-spacing: 1px;
		line-height: 1.6;
		color: #f4f4f4;
	}

	.scroll-hint {
		position: absolute;
		bottom: 2.5rem;
		right: 3rem;
		z-index: 3;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: rgba(255, 255, 255, 0.8);
		font-family: var(--font-nav);
		font-weight: 600;
		font-size: clamp(0.85rem, 1vw, 1.1rem);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		opacity: 1;
		transition: opacity 0.6s ease;
	}

	.scroll-hint.is-hidden {
		opacity: 0;
		pointer-events: none;
	}

	.scroll-hint__arrow {
		display: inline-block;
		animation: hint-bounce 1.4s ease-in-out infinite;
	}

	@keyframes hint-bounce {
		0%, 100% { transform: translateX(0); }
		50% { transform: translateX(6px); }
	}
</style>
