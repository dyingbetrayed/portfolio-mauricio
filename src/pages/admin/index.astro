---
import categories from '../../content/categories.json';
---
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>Panel de Administración — Mauricio Atencia</title>
  <style>
    #cms-loading {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #fff;
      font-family: sans-serif;
      font-size: 1rem;
      color: #666;
      z-index: 9999;
    }
  </style>
</head>
<body>
  <div id="cms-loading">Cargando panel…</div>

  <script define:vars={{ categories }}>
    // Le decimos a Sveltia que no se auto-inicialice hasta llamar a CMS.init()
    window.CMS_MANUAL_INIT = true;

    async function bootstrap() {
      // 1. Fetch & parse config
      const text = await fetch('/admin/config.yml').then(r => r.text());
      const jsyaml = await import('https://esm.sh/js-yaml@4.1.0');
      const config = jsyaml.load(text);

      // 2. Patch collection labels with live category names
      const dynamicOptions = [
        { label: categories.category_1_title || 'Categoría 1', value: 'category_1' },
        { label: categories.category_2_title || 'Categoría 2', value: 'category_2' },
        { label: categories.category_3_title || 'Categoría 3', value: 'category_3' },
        { label: categories.category_4_title || 'Categoría 4', value: 'category_4' }
      ];

      config.collections.forEach(collection => {
        if (collection.name === 'projects_category_1') {
          collection.label = categories.category_1_title || 'Categoría 1';
        } else if (collection.name === 'projects_category_2') {
          collection.label = categories.category_2_title || 'Categoría 2';
        } else if (collection.name === 'projects_category_3') {
          collection.label = categories.category_3_title || 'Categoría 3';
        } else if (collection.name === 'projects_category_4') {
          collection.label = categories.category_4_title || 'Categoría 4';
        }

        if (collection.name.startsWith('projects_category_')) {
          const catField = collection.fields?.find(f => f.name === 'category');
          if (catField) {
            catField.options = dynamicOptions;
          }
        }
      });

      // 2b. IMPORTANTE: evitar que Sveltia vuelva a cargar y mezclar config.yml,
      // ya que eso puede duplicar arrays (options, collections) por el deep merge.
      config.load_config_file = false;

      // 3. Load the CMS script dynamically so it runs AFTER config is ready
      await new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = 'https://unpkg.com/@sveltia/cms/dist/sveltia-cms.js';
        script.onload = resolve;
        script.onerror = reject;
        document.head.appendChild(script);
      });

      // 4. Init CMS with our patched config
      document.getElementById('cms-loading')?.remove();
      window.CMS.init({ config });
    }

    bootstrap().catch(err => {
      console.error('CMS bootstrap error:', err);
      const el = document.getElementById('cms-loading');
      if (el) el.textContent = 'Error al cargar el panel. Revisa la consola.';
    });
  </script>
</body>
</html>